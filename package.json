{
  "name": "oneknife999",
  "version": "0.8.95",
  "private": true,
  "type": "module",
  "description": "《一刀999》浏览器百图原型：十章 100 图纵向切片，纯前端 Canvas 实现",
  "scripts": {
    "serve": "python3 -m http.server 4174 --directory game",
    "check": "node tools/check-syntax.mjs && node tools/check-version.mjs",
    "format": "prettier --write \"game/src/**/*.js\" \"tests/**/*.{cjs,mjs}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"game/src/**/*.js\" \"tests/**/*.{cjs,mjs}\" \"tools/**/*.mjs\"",
    "verify": "npm run check && npm run format:check && npm run test:unit && npm run test:assets",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:assets": "node tools/asset-audit.mjs --json > /dev/null && node tools/asset-budget.mjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:ui:status": "node tests/ui-status-icons.cjs",
    "test:ui:status-real": "node tests/ui-status-real-combat.cjs",
    "test:ui:abyss-hud": "node tests/ui-abyss-hud-gate.cjs",
    "test:ui:levelup": "node tests/ui-levelup.cjs",
    "test:ui:regression": "node tests/ui-render-input-regression.cjs",
    "test:ui:nameplate": "node tests/ui-nameplate.cjs",
    "test:ui:blind": "node tests/ui-blind-passive.cjs",
    "test:ui:abilities": "node tests/ui-ability-flags.cjs",
    "test:e2e": "node tests/e2e-ten-clear-runs.cjs",
    "perf": "node tests/perf-probe.cjs",
    "balance": "node tests/balance-sim.mjs",
    "test:difficulty": "node tests/difficulty-probe.cjs",
    "test:ui:timeline": "node tests/ui-flow-timeline.cjs",
    "test:ui:summon": "node tests/ui-summon.cjs",
    "test:ui:elite": "node tests/ui-elite.cjs",
    "test:ui:threats": "node tests/ui-threats.cjs",
    "test:ui:layout": "node tests/ui-layout.cjs",
    "test:ui:fixes0831": "node tests/ui-fixes-0831.cjs",
    "test:ui:abyss": "node tests/ui-abyss-travel.cjs",
    "test:ui:abyss-terrain": "node tests/ui-abyss-terrain.cjs",
    "test:ui:cast": "node tests/ui-cast.cjs",
    "test:ui:touch": "node tests/ui-touch-target.cjs",
    "test:ui:pause": "node tests/ui-pause.cjs",
    "test:ui:approach": "node tests/ui-attack-approach.cjs",
    "test:ui:hint": "node tests/ui-target-hint.cjs",
    "test:ui:tooltip": "node tests/ui-tooltip.cjs",
    "test:ui:boss-adds": "node tests/ui-boss-adds-hint.cjs",
    "test:ui:hud-health": "node tests/ui-hud-health.cjs",
    "test:ui:death-save": "node tests/ui-death-save.cjs",
    "test:ui:boss-trash": "node tests/ui-boss-trash-hold.cjs",
    "test:ui:boss-alert": "node tests/ui-boss-alert-clear.cjs",
    "test:ui:echo": "node tests/ui-abyss-echo.cjs",
    "test:ui:trash": "node tests/ui-abyss-trash.cjs",
    "test:ui:preserve": "node tests/ui-abyss-preserve.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "^3.9.9"
  }
}
